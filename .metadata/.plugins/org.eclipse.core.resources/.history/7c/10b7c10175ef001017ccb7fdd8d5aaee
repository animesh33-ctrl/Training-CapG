	public static int binaryToDecimal(String binary) {
		int decimal = 0;
		int digit = binary.length();
		for(int i = 0; i < binary.length(); i++,--digit) {
			int ch = binary.charAt(i)-'0';
			if(ch==1)
			decimal += power(2,digit);
			
		}
		return decimal;

	}
