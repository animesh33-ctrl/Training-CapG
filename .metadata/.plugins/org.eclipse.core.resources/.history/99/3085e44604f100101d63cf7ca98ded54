package ObjectCreation;

public class Laptop {
	String brand;
	float price;

	public Laptop() {	}
	public Laptop(String brand, float price) {
		this.brand = brand;
		this.price = price;
	}

	void comparePrice(Laptop l1) {
		if (this.price > l1.price) {
			System.out.println(this.brand + " is more costly than " + l1.brand);
		} else {
			System.out.println(l1.brand + " is more costly than " + this.brand);
		}
	}

	public static void main(String[] args) {
		Laptop l1 = new Laptop("HP", 1200);
		Laptop l2 = new Laptop("Dell", 900);
		Laptop l3 = HelpLaptop.getLaptop();
		l3.brand = "Asus";
		l3.price=183000;
		Laptop l4 = HelpLaptop.getLaptop("Apple Mac",135000);	
		l2.comparePrice(l4);
		l1.comparePrice(l3);
		l1.comparePrice(l2);
	}
}
