package Inheritence;

class Parent{
	int a = 10;
	public void m1() {
		System.out.println("Parent Method..");
	}
}

public class Child extends Parent{
	int b = 20;
	public static void main(String[] args) {
		Child c = new Child();
		System.out.println(c.a);
		System.out.println(c.b);
		c.m1();
	}
}
