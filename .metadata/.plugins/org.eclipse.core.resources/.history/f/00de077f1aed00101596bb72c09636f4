package Operator;

import java.util.Scanner;
public class Ternay1 {
	@SuppressWarnings("unused")
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a = sc.nextInt();
		int b = sc.nextInt();
		int c = sc.nextInt();
		
		int res = (a>b && a>c)? a : (b>c)? b : c;
		System.out.println(res+" is bigger");
		
		sc.close();
	}
}
