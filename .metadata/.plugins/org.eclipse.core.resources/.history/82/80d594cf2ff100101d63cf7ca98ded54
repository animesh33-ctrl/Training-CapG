package oops.inheritence;

public class Apple {
	String color;
	String name;

	public Apple() {}
	
	public Apple(String color, String name) {
		this.color = color;
		this.name = name;
	}
	
	public static void main(String[] args) {
		Apple ap = new Apple("Kashmiri","red");
		System.out.println(ap.color);
	}
}
