package Methods;

public class CountDigit {

	public static int countDigit(int n) {
		int count = 0;
		while (n > 0) {
			count++;
			n /= 10;
		}
		return count;
	}

	public static int power(int b, int p) {
		if (p == 0)
			return 1;
		return b * power(b, p - 1);
	}

	private static boolean isArmstrong(int num, int digit) {
		int org = num;
		int sum = 0;
		while (num > 0) {
			sum += power((num % 10), digit);
			num /= 10;
		}
		return (sum == org);
	}

	public static void main(String[] args) {
		int n = 153;
		int digit = countDigit(n);
		System.out.println("Number of digits present in the count : " + digit);
		if (isArmstrong(n, digit)) {
			System.out.println("Armstrong");
		} else
			System.out.println("Not armstrong");
	}
}
