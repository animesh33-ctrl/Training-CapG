package oops.inheritence;

public class Apple {

	float price;

	public Apple() {}
	
	public Apple(float price,String color,String name) {
		this.price = price;
		this.color = color;
		this.name = name;
	}
	
	public static void main(String[] args) {
		Apple ap = new Apple(123.0f,"Kashmiri","red");
		System.out.println(ap.price);
	}
}
