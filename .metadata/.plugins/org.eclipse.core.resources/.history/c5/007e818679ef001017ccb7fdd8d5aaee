package MethodAssignment;

public class DecimalToHexadecimal {
	
	private static char arr[] = {'A','B','C','D','E','F'};
	
	private static String decimalToHexa(int num) {
		if (num == 0)
			return "0";
		StringBuilder str = new StringBuilder();
		while (num > 0) {
			int rm = num%16;
			str.insert(0, (rm>9)?(char)arr[rm-10]:rm);
			num /= 16;
		}
//		System.out.println(str);
		return str.toString();
	}
	public static void main(String[] args) {
		int num = 10;
		System.out.println(decimalToHexa(num));
	}
}
