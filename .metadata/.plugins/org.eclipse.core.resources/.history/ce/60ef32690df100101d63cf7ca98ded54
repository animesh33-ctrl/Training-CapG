package loopAssignment;

public class PrimeNumber {
	public static void main(String[] args) {
		int num = 9;
		boolean flag = false;
		for(int i=2;i<num;i++) {
			if(num % i == 0) {
				flag = true;
				break;
			}
		}
		if(flag)System.out.println("Not a Prime Number");
		else System.out.println("Prime Number");
	}
}
