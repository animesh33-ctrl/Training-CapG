package Conditional;
import java.util.Scanner;
public class WhileLoop {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int i = 1;
		System.out.println("1 to n :");
		while(i<=n) {
			System.out.println(i);
			i++;
		}
		while(n>0) {
			System.out.println(n);
			n--;
		}
	}
}
