package Conditional;

public class SwitchCase {
	public static void main(String[] args) {
		switch(3) {
		case 1:
			System.out.println("C1");
			break;
		case 2:
			System.out.println("C2");
			break;
		case 3:
			System.out.println("C3");
			break;
		default:
			System.out.println("Default Executed!!");
			break;
		}
	}
}
