package ObjectCreation;

public class HelpLaptop {
	public static Laptop getLaptop(){
		return new Laptop();
	}
	public static Laptop getLaptop(String brand,float price ){
		return new Laptop(brand,price);
	}
	
	public static Laptop verfyPrice(String brand,float price) {
		if(brand == "HP") {
			return (price>10000 && price<500000)?new Laptop():null;
		}
		else if(brand == "Dell") {
			return (price>5000 && price<400000)?new Laptop():null;
		}
	}

	
}
