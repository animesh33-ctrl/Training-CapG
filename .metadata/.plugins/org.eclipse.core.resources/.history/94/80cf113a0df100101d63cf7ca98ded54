package Conditional;

public class SwitchCase3 {
    public static void main(String[] args) {
        String operator = "Mon";
        
        // Modern arrow syntax with comma-separated cases
        switch (operator) {
            case "Mon", "Thu", "Wed" -> System.out.println("English!!");
            case "Tue", "Sat"        -> System.out.println("Java");
            default                  -> System.out.println("Enjoy!!!");
        }
    }
}