package Conditional;

public class Calculator {
	public static void main(String[] args) {
		int a=4,b=2;
		char ch = '+';
		switch(ch) {
		case '+':
			System.out.println(a+b);
			break;
		case '-':
			System.out.println(a-b);
			break;
		case '*':
			System.out.println(a*b);
			break;
		case '/':
			System.out.println(a/b);
			break;
		default:
			System.out.println("Default!!");
		}
	}

}
