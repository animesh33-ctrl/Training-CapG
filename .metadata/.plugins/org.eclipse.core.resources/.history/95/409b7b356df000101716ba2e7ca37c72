package ObjectCreation;

public class Laptop {
	String brand;
	int price;
	
	void comparePrice(Laptop l1) {
		if(this.price > l1.price) {
			System.out.println(this.brand +" is more costly than "+l1.brand);
		}
		else {
			System.out.println(l1.brand +" is more costly than "+this.brand);
		}
	}
	
	public static void main(String[] args) {
		Laptop l1 = new Laptop("HP",1200);
		Laptop l2 = new Laptop("Dell",900);
		l1.comparePrice(l2);
	}
}
